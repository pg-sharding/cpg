@@ -412,6 +424,15 @@ get_extension_script_directory(ExtensionControlFile *control)
 
 	get_share_path(my_exec_path, sharepath);
 	result = (char *) palloc(MAXPGPATH);
+	/*
+	 * If extension_destdir is set, try to find the file there first
