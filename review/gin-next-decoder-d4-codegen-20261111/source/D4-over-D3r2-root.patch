From d2866655e3b0932ce449fe8ecbf3db52404fe4f8 Mon Sep 17 00:00:00 2001
From: root <localhost>
Date: Wed, 11 Nov 2026 15:28:26 +0500
Subject: [PATCH] Route GIN decoder batches through the first-byte decision

Consume the initial byte before choosing the multibyte continuation
helper or the one-byte batch path. This allows a batch to start after
long deltas within a segment, with unchanged allocation growth and
posting-list representation.

This is an exploratory source alternative; normal release codegen was
checked, but full backend qualification and timing remain pending.
---
 src/backend/access/gin/ginpostinglist.c | 127 +++++++++---------------
 1 file changed, 48 insertions(+), 79 deletions(-)

diff --git a/src/backend/access/gin/ginpostinglist.c b/src/backend/access/gin/ginpostinglist.c
index 04d6dfc59f4..54739eddd4b 100644
--- a/src/backend/access/gin/ginpostinglist.c
+++ b/src/backend/access/gin/ginpostinglist.c
@@ -127,50 +127,47 @@ encode_varbyte(uint64 val, unsigned char **ptr)
 }
 
 /*
- * Decode varbyte-encoded integer at *ptr. *ptr is incremented to next integer.
+ * Decode the remaining bytes of a multibyte integer after the caller has
+ * consumed its first byte.  *ptr points to the second byte on entry.
  */
 static pg_always_inline uint64
-decode_varbyte(unsigned char **ptr)
+decode_varbyte_after_first(unsigned char **ptr, uint64 first)
 {
-	uint64		val;
+	uint64		val = first & 0x7F;
 	unsigned char *p = *ptr;
 	uint64		c;
 
-	/* 1st byte */
+	Assert((first & 0x80) != 0);
+
+	/* 2nd byte */
 	c = *(p++);
-	val = c & 0x7F;
+	val |= (c & 0x7F) << 7;
 	if (c & 0x80)
 	{
-		/* 2nd byte */
+		/* 3rd byte */
 		c = *(p++);
-		val |= (c & 0x7F) << 7;
+		val |= (c & 0x7F) << 14;
 		if (c & 0x80)
 		{
-			/* 3rd byte */
+			/* 4th byte */
 			c = *(p++);
-			val |= (c & 0x7F) << 14;
+			val |= (c & 0x7F) << 21;
 			if (c & 0x80)
 			{
-				/* 4th byte */
+				/* 5th byte */
 				c = *(p++);
-				val |= (c & 0x7F) << 21;
+				val |= (c & 0x7F) << 28;
 				if (c & 0x80)
 				{
-					/* 5th byte */
+					/* 6th byte */
 					c = *(p++);
-					val |= (c & 0x7F) << 28;
+					val |= (c & 0x7F) << 35;
 					if (c & 0x80)
 					{
-						/* 6th byte */
+						/* 7th byte, should not have continuation bit */
 						c = *(p++);
-						val |= (c & 0x7F) << 35;
-						if (c & 0x80)
-						{
-							/* 7th byte, should not have continuation bit */
-							c = *(p++);
-							val |= c << 42;
-							Assert((c & 0x80) == 0);
-						}
+						val |= c << 42;
+						Assert((c & 0x80) == 0);
 					}
 				}
 			}
@@ -329,68 +326,40 @@ ginPostingListDecodeAllSegments(GinPostingList *segment, int len, int *ndecoded_
 		val = itemptr_to_uint64(&segment->first);
 		ptr = segment->bytes;
 		endptr = segment->bytes + segment->nbytes;
-		/*
-		 * Use the batched loop only when the segment starts with four
-		 * one-byte deltas.  Otherwise keep the scalar loop for this segment,
-		 * without testing batch eligibility for every decoded item.
-		 */
-		if (endptr - ptr >= 4 &&
-			((ptr[0] | ptr[1] | ptr[2] | ptr[3]) & 0x80) == 0)
+		while (ptr < endptr)
 		{
-			while (ptr < endptr)
-			{
-				/* enlarge output array if needed */
-				if (ndecoded >= nallocated)
-				{
-					nallocated *= 2;
-					result = repalloc_array(result, ItemPointerData, nallocated);
-				}
+			uint64		delta;
 
-				/*
-				 * Decode a run of four complete one-byte deltas together.  Both
-				 * the input and output bounds are checked before touching the
-				 * batch.  Reject a long first delta before testing the batch.
-				 * Longer deltas and short tails use the usual decoder.  The
-				 * allocation policy and on-disk representation are unchanged.
-				 */
-				if ((ptr[0] & 0x80) == 0 &&
-					endptr - ptr >= 4 && nallocated - ndecoded >= 4 &&
-					((ptr[1] | ptr[2] | ptr[3]) & 0x80) == 0)
-				{
-					val += ptr[0];
-					uint64_to_itemptr(val, &result[ndecoded++]);
-					val += ptr[1];
-					uint64_to_itemptr(val, &result[ndecoded++]);
-					val += ptr[2];
-					uint64_to_itemptr(val, &result[ndecoded++]);
-					val += ptr[3];
-					uint64_to_itemptr(val, &result[ndecoded++]);
-					ptr += 4;
-					continue;
-				}
-
-				val += decode_varbyte(&ptr);
-
-				uint64_to_itemptr(val, &result[ndecoded]);
-				ndecoded++;
-			}
-		}
-		else
-		{
-			while (ptr < endptr)
+			/* enlarge output array if needed */
+			if (ndecoded >= nallocated)
 			{
-				/* enlarge output array if needed */
-				if (ndecoded >= nallocated)
-				{
-					nallocated *= 2;
-					result = repalloc_array(result, ItemPointerData, nallocated);
-				}
-
-				val += decode_varbyte(&ptr);
+				nallocated *= 2;
+				result = repalloc_array(result, ItemPointerData, nallocated);
+			}
 
-				uint64_to_itemptr(val, &result[ndecoded]);
-				ndecoded++;
+			/* The ordinary first-byte decision also selects batch eligibility. */
+			delta = *(ptr++);
+			if (delta & 0x80)
+				delta = decode_varbyte_after_first(&ptr, delta);
+			else if (endptr - ptr >= 3 && nallocated - ndecoded >= 4 &&
+					 ((ptr[0] | ptr[1] | ptr[2]) & 0x80) == 0)
+			{
+				/* Four complete one-byte deltas, including the consumed byte. */
+				val += delta;
+				uint64_to_itemptr(val, &result[ndecoded++]);
+				val += ptr[0];
+				uint64_to_itemptr(val, &result[ndecoded++]);
+				val += ptr[1];
+				uint64_to_itemptr(val, &result[ndecoded++]);
+				val += ptr[2];
+				uint64_to_itemptr(val, &result[ndecoded++]);
+				ptr += 3;
+				continue;
 			}
+
+			val += delta;
+			uint64_to_itemptr(val, &result[ndecoded]);
+			ndecoded++;
 		}
 		segment = GinNextPostingListSegment(segment);
 	}
-- 
