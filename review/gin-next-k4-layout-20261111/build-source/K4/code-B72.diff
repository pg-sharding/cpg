 #define MAX_MAYBE_ENTRIES	4
 
+/* This is a bounded builtin specialization, not an opclass purity promise. */
+#define TSQUERY_CACHE_MAX_ENTRIES 8
+#define TSQUERY_CACHE_MAX_MISSES 64
+
+struct GinTriConsistentCacheData
+{
+	bool		valid;
+	uint32		nentries;
+	uint32		misses;
+	GinTernaryValue result;
+	GinTernaryValue entryRes[TSQUERY_CACHE_MAX_ENTRIES];
+};
+
 /*
  * Dummy consistent functions for an EVERYTHING key.  Just claim it matches.
  */
@@ -99,6 +114,69 @@ directTriConsistentFn(GinScanKey key)
 													 PointerGetDatum(key->queryCategories)));
 }
 
+/*
+ * Native tri callbacks leave recheckCurItem unchanged.  Return the same ternary
+ * value here, including MAYBE, without manufacturing a new recheck state.
+ * All other callback inputs are fixed for the lifetime of this scan key.
+ */
+static GinTernaryValue
+cachedTsqueryTriConsistentFn(GinScanKey key)
+{
+	GinTriConsistentCacheData *cache = key->triCache;
+	GinTernaryValue result;
+
+	/* A hidden entry may have been appended after initialization. */
+	if (key->nentries > TSQUERY_CACHE_MAX_ENTRIES)
+	{
+		cache->valid = false;
+		return directTriConsistentFn(key);
+	}
+	if (cache->valid && cache->nentries == key->nentries &&
+		memcmp(cache->entryRes, key->entryRes,
+			   key->nentries * sizeof(GinTernaryValue)) == 0)
+	{
+		cache->misses = 0;
+		return cache->result;
+	}
+	result = directTriConsistentFn(key);
+	/* Stop paying for the memo after a fixed consecutive miss budget. */
+	if (++cache->misses >= TSQUERY_CACHE_MAX_MISSES)
+	{
+		cache->valid = false;
+		key->triConsistentFn = directTriConsistentFn;
+		return result;
+	}
+	memcpy(cache->entryRes, key->entryRes,
+		   key->nentries * sizeof(GinTernaryValue));
+	cache->nentries = key->nentries;
+	cache->result = result;
+	cache->valid = true;
+	return result;
+}
+
+/*
+ * Arbitrary opclasses may keep mutable state in extra_data.  Only specialize
+ * the reviewed builtin support set, checking native addresses as well as OIDs.
+ * In particular, a user callback must not change the query map behind a memo.
+ */
+static bool
+isBuiltinTsquerySupport(GinState *ginstate, OffsetNumber attnum)
+{
+	int			i = attnum - 1;
+
+	return ginstate->compareFn[i].fn_oid == F_GIN_CMP_TSLEXEME &&
+		ginstate->compareFn[i].fn_addr == gin_cmp_tslexeme &&
+		ginstate->extractQueryFn[i].fn_oid == F_GIN_EXTRACT_TSQUERY_TSVECTOR_INTERNAL_INT2_INTERNAL_INTERNAL_INTERNAL_INTERNAL &&
+		ginstate->extractQueryFn[i].fn_addr == gin_extract_tsquery &&
+		ginstate->consistentFn[i].fn_oid == F_GIN_TSQUERY_CONSISTENT_INTERNAL_INT2_TSVECTOR_INT4_INTERNAL_INTERNAL_INTERNAL_INTERNAL &&
+		ginstate->consistentFn[i].fn_addr == gin_tsquery_consistent &&
+		ginstate->triConsistentFn[i].fn_oid == F_GIN_TSQUERY_TRICONSISTENT &&
+		ginstate->triConsistentFn[i].fn_addr == gin_tsquery_triconsistent &&
+		ginstate->canPartialMatch[i] &&
+		ginstate->comparePartialFn[i].fn_oid == F_GIN_CMP_PREFIX &&
+		ginstate->comparePartialFn[i].fn_addr == gin_cmp_prefix;
+}
+
 /*
  * This function implements a binary logic consistency check, using a ternary
  * logic consistent function provided by the opclass. GIN_MAYBE return value
@@ -227,6 +305,7 @@ shimTriConsistentFn(GinScanKey key)
